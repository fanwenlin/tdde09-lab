def replace(ids: list[int], pair: Pair, new_id: int) -> list[int]:
    # TODO: Replace the following line with your own code
    new_ids = []
    i = 0
    while i < len(ids)-1: # 2 words left
        if (ids[i], ids[i+1]) == pair:
            new_ids.append(new_id)
            i += 2
        else:
            new_ids.append(ids[i])
            i += 1
    if i < len(ids):
        new_ids.append(ids[i])
    return new_ids


