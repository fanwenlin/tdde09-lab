from collections import Counter

def count(ids: list[int]) -> dict[Pair, int]:
    # TODO: Replace the following line with your own code
    pairs = [(l,r) for (l,r) in zip(ids[0:-1], ids[1:])]
    # print(pairs)
    return dict(Counter(pairs))


